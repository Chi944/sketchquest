{
  "name": "sketchquest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:vercel": "tsc -b && vite build --config vite.vercel.config.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "db:migrate": "wrangler d1 migrations apply sketchquest --local",
    "db:migrate:remote": "wrangler d1 migrations apply sketchquest --remote",
    "deploy": "npm run build && wrangler deploy",
    "deploy:vercel": "vercel deploy --prod --yes",
    "eval:solver": "tsx scripts/evaluate-solver.ts",
    "eval:dataset": "tsx eval/generate-synthetic.ts",
    "eval:extraction": "tsx scripts/evaluate-extraction.ts"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/nunito-sans": "5.3.0",
    "@vercel/blob": "2.8.0",
    "heic-to": "1.5.2",
    "hono": "4.13.7",
    "idb": "8.0.3",
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "1.54.8",
    "@cloudflare/workers-types": "5.20260911.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "wrangler": "4.131.1"
  }
}
